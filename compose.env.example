# 本文件仅保留给本地开发和历史兼容。
# v1.0.0 正式 Docker Compose 部署以 docker-compose.yml 为唯一配置入口。
# 不要把真实密钥、授权码、access token 或数据库密码提交到 Git。
BPMT_OAUTH_DEMO_IMAGE=bpmt-oauth-demo:local
BPMT_OAUTH_DEMO_CONTAINER=bpmt-oauth-demo
DEMO_HTTP_PORT=81

NODE_ENV=production
SESSION_SECRET=<DEMO_SESSION_SECRET>

# 浏览器访问 BPMT 的地址，通常保持 localhost。
BPMT_BASE_URL=http://localhost
# 容器内访问宿主机 BPMT 的地址。Docker Desktop 和 Linux host-gateway 均优先使用 host.docker.internal。
BPMT_SERVER_BASE_URL=http://host.docker.internal
BPMT_OAUTH_CLIENT_ID=bpmt-oauth-demo
BPMT_OAUTH_CLIENT_SECRET=<BPMT_OAUTH_CLIENT_SECRET>
BPMT_OAUTH_REDIRECT_URI=http://localhost:81/oauth/callback

BPMT_API_BASE_URL=http://host.docker.internal/api
BPMT_API_APP_KEY=bpmt-api
BPMT_API_APP_SECRET=<BPMT_API_APP_SECRET>

DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=bpmt
