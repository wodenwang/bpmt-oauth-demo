<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/styles/bpmt.css">
  <script src="/static/scripts/messages.js" defer></script>
</head>
<body>
  <main class="app-shell">
    <header class="app-header">
      <div>
        <p class="eyebrow">bpmt-oauth-demo</p>
        <h1>留言登记</h1>
        <p class="user-line">当前用户：<%= user.name || user.userid %></p>
      </div>
      <form method="post" action="/logout">
        <button class="text-button" type="submit">退出</button>
      </form>
    </header>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>

    <% if (setupRequired) { %>
      <section class="empty-state">
        <h2>请先运行初始化命令</h2>
        <p>当前数据库中未检测到 <code>DEMO_MESSAGE</code>。请在服务端执行 <code>npm run setup</code> 后刷新本页。</p>
      </section>
    <% } else { %>
      <section class="feed-toolbar">
        <a class="primary-action" href="/messages/new">新增留言</a>
        <button class="secondary-action" type="button" data-toggle-filter>筛选</button>
      </section>

      <form class="filter-panel" method="get" action="/" data-filter-panel>
        <label for="filter-title">标题</label>
        <input id="filter-title" type="text" name="title" value="<%= filters.title %>" placeholder="输入标题关键词">
        <label for="filter-creator">创建者</label>
        <input id="filter-creator" type="text" name="creatorUserid" value="<%= filters.creatorUserid %>" placeholder="输入 userid">
        <input type="hidden" name="pageSize" value="<%= result.pageSize %>">
        <div class="form-actions">
          <button type="submit" class="primary-action">查询</button>
          <a class="secondary-action" href="/">重置</a>
        </div>
      </form>

      <section class="message-feed" aria-label="留言列表">
        <% if (result.rows.length === 0) { %>
          <div class="empty-state">
            <h2>暂无留言</h2>
            <p>可以新增第一条留言，或调整筛选条件后重试。</p>
          </div>
        <% } %>
        <% for (const row of result.rows) { %>
          <%
            const owned = row.creatorUserid === user.userid;
            const encodedId = encodeURIComponent(row.id);
            const content = String(row.content || '');
            const summary = content.length > 96 ? `${content.slice(0, 96)}...` : content;
          %>
          <article class="message-card">
            <div class="card-main">
              <h2><a href="/messages/<%= encodedId %>"><%= row.title %></a></h2>
              <p><%= summary %></p>
            </div>
            <dl class="message-meta">
              <div><dt>创建者</dt><dd><%= row.creatorUserid %></dd></div>
              <div><dt>创建时间</dt><dd><%= row.createTime || '' %></dd></div>
              <div><dt>更新时间</dt><dd><%= row.updateTime || '' %></dd></div>
            </dl>
            <div class="card-actions">
              <a class="secondary-action" href="/messages/<%= encodedId %>">查看</a>
              <% if (owned) { %>
                <a class="secondary-action" href="/messages/<%= encodedId %>/edit">编辑</a>
                <form method="post" action="/messages/<%= encodedId %>/delete" data-confirm-delete>
                  <button class="danger-action" type="submit">删除</button>
                </form>
              <% } %>
            </div>
          </article>
        <% } %>
      </section>

      <nav class="pager" aria-label="分页">
        <a class="secondary-action" href="/?title=<%= encodeURIComponent(filters.title) %>&creatorUserid=<%= encodeURIComponent(filters.creatorUserid) %>&page=<%= Math.max(1, result.page - 1) %>&pageSize=<%= result.pageSize %>">上一页</a>
        <span>第 <%= result.page %> / <%= result.totalPages %> 页，共 <%= result.total %> 条</span>
        <a class="secondary-action" href="/?title=<%= encodeURIComponent(filters.title) %>&creatorUserid=<%= encodeURIComponent(filters.creatorUserid) %>&page=<%= Math.min(result.totalPages, result.page + 1) %>&pageSize=<%= result.pageSize %>">下一页</a>
      </nav>
    <% } %>
  </main>
</body>
</html>
