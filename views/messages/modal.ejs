<section>
  <h1><%= mode === 'edit' ? '编辑留言' : '查看留言' %></h1>
  <% if (mode === 'edit') { %>
    <form method="post" action="/messages/<%= message.id %>/update">
      <label>
        标题
        <input name="title" value="<%= message.title %>" required>
      </label>
      <label>
        内容
        <textarea name="content" required><%= message.content %></textarea>
      </label>
      <button type="submit">保存</button>
    </form>
  <% } else { %>
    <p><%= message.title %></p>
    <p><%= message.content %></p>
    <p>创建人：<%= message.creatorUserid %></p>
  <% } %>
</section>
